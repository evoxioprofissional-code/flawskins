# Supabase — copie para .env.local e preencha com os valores do seu projeto
# Painel: https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Mercado Pago (Pix das rifas) — server-only, NUNCA commitar valores reais
# Painel: https://www.mercadopago.com.br/developers/panel
MP_ACCESS_TOKEN=
MP_PUBLIC_KEY=
# Segredo que protege o webhook (gere um valor aleatório; o mesmo valor deve
# estar gravado na tabela public.app_config -> key 'mp_webhook_secret')
MP_WEBHOOK_SECRET=
# URL pública do site (para o Mercado Pago notificar o webhook)
NEXT_PUBLIC_SITE_URL=https://visionskins.net

# Service role do Supabase (server-only) — necessária na FASE do split das cotas
SUPABASE_SERVICE_ROLE_KEY=

# Steam Web API key (https://steamcommunity.com/dev/apikey) — domínio visionskins.net.
# Deixa o nome/avatar do login com Steam confiável (a api.steampowered.com não
# bloqueia o servidor como o steamcommunity.com). Opcional, mas recomendado.
STEAM_API_KEY=

# SteamWebAPI (https://www.steamwebapi.com) — preço de referência Buff163/Steam
# no card/detalhe. Plano grátis = 2 req/min, então buscamos sob demanda e
# cacheamos no banco (tabela skin_precos). Opcional.
STEAMWEBAPI_KEY=

# PandaScore (Cloud E-Sports) — server-only. NUNCA usar prefixo NEXT_PUBLIC_.
# https://app.pandascore.co/dashboard
PANDASCORE_TOKEN=
# Segredo da rota /api/esports/sync (Authorization: Bearer <valor>). Opcional.
ESPORTS_SYNC_SECRET=

# NexusPag (webhooks) — server-only. Segredo em Dashboard / Integracoes / Webhooks.
# Rota a cadastrar no painel: https://cloudskins.pro/api/webhooks/nexuspag
NEXUSPAG_WEBHOOK_SECRET=
# Janela de tolerância do timestamp da assinatura, em segundos (padrão 300).
NEXUSPAG_WEBHOOK_TOLERANCE_SECONDS=
# Só para testes em localhost sem banco: "memory" (ignorado em produção).
NEXUSPAG_WEBHOOK_STORE=

# NexusPag — SAQUES (server-only). Chave EXCLUSIVA de saques, separada das demais.
NEXUSPAG_WITHDRAW_API_KEY=
# Subconta da Cloud de onde saem os saques (UUID ou external_ref).
NEXUSPAG_WITHDRAW_SHOP_ID=
# Envio automático de saques. Padrão: desligado (saques ficam na fila do admin).
NEXUSPAG_WITHDRAW_ENABLED=false
